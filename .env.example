# =====================================================================
# .env.example -- copy to ".env" and edit:   cp .env.example .env
# (Windows PowerShell: Copy-Item .env.example .env)
# ".env" is git-ignored: never commit real passwords.
# Format: KEY=VALUE, no quotes, no spaces around "=".
# Real environment variables override values in this file.
# =====================================================================

# ---- MySQL / MariaDB (the system of record) ---------------------------
MYSQL_HOST=127.0.0.1
# 3306 = a MySQL/MariaDB installed on your machine
# 3307 = the Docker container from docker-compose.yml (avoids clashing with a local server)
MYSQL_PORT=3306
MYSQL_USER=timetable
MYSQL_PASSWORD=change_me_timetable
MYSQL_DATABASE=university_timetable
# Optional: connect through a Unix socket instead of TCP (local installs on Linux/macOS)
# MYSQL_UNIX_SOCKET=/run/mysqld/mysqld.sock

# ---- Role accounts (used by the API; created by docker/mysql/07_role_accounts.sh) ----
# Each API request runs on the account matching the logged-in user's role and then
# activates that SQL role (SET ROLE tt_admin / tt_faculty, see sql/06_auth_roles.sql).
# MYSQL_USER above stays the service account (CLI scripts, ETL, tests, login lookup).
MYSQL_ADMIN_USER=tt_admin_app
MYSQL_ADMIN_PASSWORD=change_me_admin_app
MYSQL_FACULTY_USER=tt_faculty_app
MYSQL_FACULTY_PASSWORD=change_me_faculty_app

# ---- Web API (FastAPI, api/) and web app (Next.js, web/) ---------------------
# Secret that signs the session cookie. REQUIRED: the API refuses to start without it.
# The value below is a DEV-ONLY placeholder; generate a real one with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET=dev-only-change-me-to-a-long-random-string
# Where the Next.js server forwards /api/* (the FastAPI server started with uvicorn)
API_URL=http://127.0.0.1:8000

# ---- Neo4j (graph analytics) --------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Neo4j requires at least 8 characters. For a native install this must equal the
# password you set with: neo4j-admin dbms set-initial-password
NEO4J_PASSWORD=change_me_neo4j
NEO4J_DATABASE=neo4j

# ---- Application ------------------------------------------------------------
# Academic year used by default (generator, ETL, UI)
ACADEMIC_YEAR=2026-2027

# ---- Docker only (read by docker-compose.yml) ---------------------------------
# MYSQL_ROOT_PASSWORD=change_me_root
# MYSQL_HOST_PORT=3307